ARGUS_ENV=development
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8000
ARGUS_LOG_LEVEL=INFO
ARGUS_MODEL_NAME=placeholder
ARGUS_MAX_IMAGE_BYTES=10485760
